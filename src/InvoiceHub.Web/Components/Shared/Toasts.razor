@implements IDisposable
@inject ToastService Service

<div class="toasts" role="status" aria-live="polite">
    @foreach (var toast in Service.Toasts)
    {
        <div class="toast @(toast.Kind == ToastKind.Success ? "toast-success" : "")" @key="toast.Id">
            <div>
                <strong>@toast.Title</strong>
                <p>@toast.Text</p>
            </div>
            <button type="button" class="link" aria-label="Dismiss" @onclick="() => Service.Dismiss(toast.Id)">Dismiss</button>
        </div>
    }
</div>

@code {
    private readonly HashSet<Guid> _timed = [];

    protected override void OnInitialized() => Service.Changed += OnChanged;

    private void OnChanged()
    {
        foreach (var toast in Service.Toasts.Where(t => _timed.Add(t.Id)).ToList())
        {
            var id = toast.Id;
            _ = Task.Delay(TimeSpan.FromSeconds(8)).ContinueWith(_ => InvokeAsync(() => Service.Dismiss(id)));
        }
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Service.Changed -= OnChanged;
}
