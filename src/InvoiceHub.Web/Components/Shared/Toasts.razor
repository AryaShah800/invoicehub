@implements IDisposable
@inject ToastService Service

<div class="toasts" role="status" aria-live="polite">
    @foreach (var toast in Service.Toasts)
    {
        <div class="toast @(toast.Kind == ToastKind.Success ? "toast-success" : "")" @key="toast.Id">
            <div>
                <strong>@toast.Title</strong>
                <p>@toast.Text</p>
            </div>
            <button type="button" class="link" aria-label="Dismiss" @onclick="() => Service.Dismiss(toast.Id)">Dismiss</button>
        </div>
    }
</div>

@code {
    /// <summary>How long a toast stays before it dismisses itself.</summary>
    [Parameter] public TimeSpan Lifetime { get; set; } = TimeSpan.FromSeconds(8);

    private readonly HashSet<Guid> _timed = [];
    // Cancelled when the component goes away (page left, circuit closed), so pending timers
    // stop instead of calling InvokeAsync on a renderer that no longer exists.
    private readonly CancellationTokenSource _disposed = new();

    protected override void OnInitialized() => Service.Changed += OnChanged;

    private void OnChanged()
    {
        var current = Service.Toasts.Select(t => t.Id).ToHashSet();
        _timed.IntersectWith(current); // forget toasts that are already gone
        foreach (var id in current.Where(_timed.Add).ToList())
            _ = DismissLaterAsync(id);
        InvokeAsync(StateHasChanged);
    }

    private async Task DismissLaterAsync(Guid id)
    {
        try
        {
            await Task.Delay(Lifetime, _disposed.Token);
            await InvokeAsync(() => Service.Dismiss(id));
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public void Dispose()
    {
        Service.Changed -= OnChanged;
        _disposed.Cancel();
        _disposed.Dispose();
    }
}
