@using System.Globalization
<figure class="chart">
    <svg viewBox="0 0 @W @H" role="img" aria-label="@Summary" preserveAspectRatio="xMidYMid meet">
        @foreach (var tick in Ticks)
        {
            var y = Y(tick);
            <line x1="@L" x2="@(W - 8)" y1="@Num(y)" y2="@Num(y)" class="grid" />
            @Label(L - 8, y + 4, "end", Money.Compact(tick))
        }
        @for (var i = 0; i < Months.Count; i++)
        {
            var m = Months[i];
            var x = L + i * Step + (Step - BarW) / 2;
            var h = (double)(m.Total / Max) * (H - T - B);
            <rect x="@Num(x)" y="@Num(H - B - h)" width="@Num(BarW)" height="@Num(h)" rx="3" class="@(i == Months.Count - 1 ? "bar bar-now" : "bar")">
                <title>@Money.Month(m.Year, m.Month) @m.Year: @Money.Format(m.Total) from @m.InvoiceCount invoices</title>
            </rect>
            @Label(x + BarW / 2, H - 8, "middle", Money.Month(m.Year, m.Month))
        }
    </svg>
</figure>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MonthlyRevenue> Months { get; set; } = [];

    private const int W = 640, H = 260, L = 48, T = 12, B = 28;
    private double Step => (W - L - 8) / (double)Math.Max(Months.Count, 1);
    private double BarW => Step * 0.62;

    private decimal Max => NiceMax(Months.Count == 0 ? 0 : Months.Max(m => m.Total));
    private IEnumerable<decimal> Ticks => Enumerable.Range(0, 5).Select(i => Max * i / 4);
    private double Y(decimal v) => H - B - (double)(v / Max) * (H - T - B);

    private string Summary => Months.Count == 0
        ? "No billed invoices"
        : $"Billed value per month, {Money.Month(Months[0].Year, Months[0].Month)} {Months[0].Year} to {Money.Month(Months[^1].Year, Months[^1].Month)} {Months[^1].Year}. Total {Money.Format(Months.Sum(m => m.Total))}.";

    // <text> is a reserved tag inside Razor code blocks, so SVG labels are emitted as markup strings (values are numbers or month names).
    private static MarkupString Label(double x, double y, string anchor, string text) =>
        new($"<text x=\"{Num(x)}\" y=\"{Num(y)}\" text-anchor=\"{anchor}\" class=\"axis\">{System.Net.WebUtility.HtmlEncode(text)}</text>");

    private static string Num(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>Rounds the top of the axis up to 1, 2, 2.5, 5 or 10 times a power of ten.</summary>
    internal static decimal NiceMax(decimal value)
    {
        if (value <= 0) return 1000m;
        var magnitude = (decimal)Math.Pow(10, Math.Floor(Math.Log10((double)value)));
        foreach (var step in new[] { 1m, 2m, 2.5m, 5m, 10m })
            if (value <= step * magnitude) return step * magnitude;
        return 10m * magnitude;
    }
}
